// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id                    String   @id @default(uuid())
  orderNo               Int      @default(0)
  customerName          String
  platform              String?
  socialMediaName       String?
  crispyPorkPiece       String?
  crispyPorkWeight      String?
  packedPork            String?
  promotion             String?
  price                 Float?
  shippingMethod        String?
  additionalShippingCost Float?
  codAmount             Float?
  codConfirmed          Boolean  @default(false)
  actualReceivedAmount  Float?
  transferSlip          String?
  paymentStatus         String?
  customerAddress       String?
  orderStatus           String?
  rackDetails           String?
  sellerName            String?
  trackingNumber        String?
  adminNote             String?
  createdAt             DateTime @default(now())
}

model User {
  id       String @id @default(uuid())
  name     String
  role     String @default("ADMIN") // "SUPER_ADMIN" | "ADMIN"
  racks    RackAssignment[]
}

model DailyCounter {
  date      String @id
  lastOrder Int    @default(0)
}

model RackAssignment {
  id              String   @id @default(uuid())
  rackNo          String
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  initialWeight   Float    @default(0)
  remainingWeight Float    @default(0)
  isUsedUp        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([userId, rackNo])
}

model DeletedPorkLog {
  id              String   @id @default(uuid())
  rackNo          String
  weight          Float
  userName        String
  deletedAt       DateTime @default(now())
}
