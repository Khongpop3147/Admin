// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id                    String   @id @default(uuid())
  orderNo               Int      @default(0)
  customerName          String
  platform              String?
  socialMediaName       String?
  crispyPorkPiece       String?
  crispyPorkWeight      String?
  packedPork            String?
  promotion             String?
  price                 Float?
  shippingMethod        String?
  additionalShippingCost Float?
  codAmount             Float?
  codConfirmed          Boolean  @default(false)
  isReturned            Boolean  @default(false)
  actualReceivedAmount  Float?
  transferSlip          String?
  paymentStatus         String?
  customerAddress       String?
  orderStatus           String?
  rackDetails           String?
  sellerName            String?
  trackingNumber        String?
  adminNote             String?
  createdAt             DateTime @default(now())
}

model User {
  id             String  @id @default(uuid())
  name           String
  role           String  @default("ADMIN") // "SUPER_ADMIN" | "ADMIN" | "PACKING" | "CENTRAL_INVENTORY" | "DEV"
  password       String? // bcrypt hash; null = login not set up yet for this account
  sessionVersion Int     @default(0) // bumped to force-invalidate every existing login for this user
  racks          RackAssignment[]
}

model DailyCounter {
  date      String @id
  lastOrder Int    @default(0)
}

model RackAssignment {
  id              String   @id @default(uuid())
  rackNo          String
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  initialWeight   Float    @default(0)
  remainingWeight Float    @default(0)
  isUsedUp        Boolean   @default(false)
  usedUpAt        DateTime?
  createdAt       DateTime  @default(now())

  @@unique([userId, rackNo])
}

model DeletedPorkLog {
  id              String   @id @default(uuid())
  rackNo          String
  weight          Float
  userName        String
  deletedAt       DateTime @default(now())
}

model Settings {
  id                  String   @id
  commissionRate      Float    @default(0.2)
  returnPenalty       Float    @default(50)
  codFlatFeeThreshold Float    @default(2.29)
  codFlatFee          Float    @default(50)
  codDivisor          Float    @default(1.5)
  codMultiplier       Float    @default(20)
  porkPricePerKg      Float    @default(250)
  lastPorkCleanupMonth String?
  lastSlipCleanupDate String?
  updatedAt           DateTime @updatedAt
}

model OrderAuditLog {
  id          String   @id @default(uuid())
  orderId     String?
  action      String
  summary     String
  performedBy String?
  createdAt   DateTime @default(now())
}
