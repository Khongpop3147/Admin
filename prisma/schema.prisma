// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id                    String   @id @default(uuid())
  orderNo               Int      @default(0)
  customerName          String
  platform              String?
  socialMediaName       String?
  crispyPorkPiece       String?
  crispyPorkWeight      String?
  packedPork            String?
  promotion             String?
  price                 Float?
  shippingMethod        String?
  additionalShippingCost Float?
  codAmount             Float?
  codConfirmed          Boolean  @default(false)
  isReturned            Boolean  @default(false)
  // A free replacement for a customer's quality complaint ("ลูกค้าเคลม") —
  // real pork still gets picked and deducted from stock normally (see
  // rackDetails below), but price/shipping/COD are all forced to 0 server-
  // side regardless of what the client sends, and it's excluded from
  // revenue/commission the same way a returned order is (see
  // isExcludedFromRevenue / commissionForOrder in lib/money.ts).
  isClaim               Boolean  @default(false)
  actualReceivedAmount  Float?
  transferSlip          String?
  paymentStatus         String?
  customerAddress       String?
  // Entered as their own fields (not parsed out of customerAddress) so an
  // admin can fill them independently — validated client-side as exactly 10
  // digits / exactly 5 digits (lib/addressParse.ts's isValidPhone/isValidZip)
  // but not enforced server-side, since order entry deliberately allows
  // saving with an incomplete number rather than blocking the sale. Postone
  // export prefers these when valid, falling back to parseAddressBlock's
  // regex extraction from customerAddress for orders entered before this
  // existed.
  customerPhone         String?
  customerZip           String?
  // Whether the customer asked for a tax invoice (ใบกำกับภาษี) — set from
  // Order Details, surfaced as a badge on the order's row in HR Manage so
  // whoever prepares invoices can see which orders need one without opening
  // each order individually.
  needsTaxInvoice       Boolean  @default(false)
  orderStatus           String?
  rackDetails           String?
  sellerName            String?
  trackingNumber        String?
  adminNote             String?
  // Piece count per physical box (box 2, 3, ...), each an array of indices
  // into rackDetails identifying which specific pork pieces go in that box.
  // Box 1 is never stored — it's always whatever pieces aren't claimed by
  // another box, computed fresh (see getBox1Indices in app/packing/page.tsx).
  // Only meaningful once an order's weight exceeds the per-box cap (see
  // computeBoxCount in lib/shipping.ts); null/empty otherwise.
  boxPieceCounts        String?
  // The Bangkok-local "YYYY-MM-DD" this order counts as for order numbering
  // and the Packing view — normally today, but an admin can back/forward-date
  // it at entry time. Deliberately separate from createdAt (the real
  // submission instant), which still drives Dashboard, Order Details, and
  // duplicate detection unchanged.
  entryDate             String
  // Overrides which day this order shows up on in Packing, independent of
  // entryDate — only set for an order converted from a "ลูกค้ารอหมู" waiting
  // entry (see app/api/pending-stock/[id]/send-to-packing), where entryDate
  // deliberately stays the day the customer originally paid (so Order
  // Details/Dashboard/duplicate-detection show the real sale date), but
  // Packing still needs to see it the day after stock actually got
  // assigned, which can be many days later. Same "one day before it ships"
  // meaning as entryDate has for every other order — null for all of them,
  // Packing just falls back to its usual entryDate-based lookup.
  packingEntryDate      String?
  createdAt             DateTime @default(now())
  // Extra slips beyond transferSlip (the primary one) — for when a customer
  // pays short the first time and transfers the rest separately. transferSlip
  // itself is untouched by this: every existing order and every order with
  // just one slip behaves exactly as before.
  extraSlips            OrderSlip[]
  // Per-product line items — added when Order Entry gained multi-product
  // support. crispyPorkWeight/crispyPorkPiece/price above keep meaning "sum
  // across items" so every reader that predates this stays correct without
  // changes. An order created before this feature has zero items; treat
  // that as an implicit single PORK line (see lib/orderItems.ts).
  items                 OrderItem[]
}

model OrderSlip {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productType String   @default("PORK")
  weight      Float
  pieceCount  Int?
  // Snapshot of the rate used at order time, independent of whatever
  // Settings.porkPricePerKg/porkLoinPricePerKg later change to.
  pricePerKg  Float?
  price       Float
  createdAt   DateTime @default(now())
}

model User {
  id             String  @id @default(uuid())
  name           String
  nickname       String? // shown instead of `name` on the per-admin pork slip sections
  defaultPlatform String? // pre-selects this sales channel in Order Entry for this admin; null = no default
  role           String  @default("ADMIN") // "SUPER_ADMIN" | "ADMIN" | "PACKING" | "CENTRAL_INVENTORY" | "DEV" | "HR" | "STOREFRONT"
  // Grants Storefront page access on top of whatever `role` already allows —
  // for a non-STOREFRONT account (e.g. HR) that also needs to run the
  // counter, without giving up their primary role's own access.
  canAccessStorefront Boolean @default(false)
  password       String? // bcrypt hash; null = login not set up yet for this account
  sessionVersion Int     @default(0) // bumped to force-invalidate every existing login for this user
  racks          RackAssignment[]
  pets           Pet[]
}

model DailyCounter {
  date      String @id
  lastOrder Int    @default(0)
}

model RackAssignment {
  id              String   @id @default(uuid())
  rackNo          String
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  initialWeight   Float    @default(0)
  remainingWeight Float    @default(0)
  isUsedUp        Boolean   @default(false)
  usedUpAt        DateTime?
  createdAt       DateTime  @default(now())
  // Which product this piece is ("PORK" = the original หมูกรอบ, "PORK_LOIN"
  // = หมูกรอบสันนอก added later) — see lib/rackCode.ts's PRODUCT_TYPES for
  // the registry and each product's rack-code format. Defaults every
  // existing row to the original product with no backfill needed.
  productType     String    @default("PORK")

  @@unique([userId, rackNo])
}

model DeletedPorkLog {
  id              String   @id @default(uuid())
  rackNo          String
  weight          Float
  userName        String
  deletedAt       DateTime @default(now())
  productType     String   @default("PORK")
}

model Settings {
  id                  String   @id
  commissionRate      Float    @default(0.2)
  returnPenalty       Float    @default(50)
  codFlatFeeThreshold Float    @default(2.29)
  codFlatFee          Float    @default(50)
  codDivisor          Float    @default(1.5)
  codMultiplier       Float    @default(20)
  porkPricePerKg      Float    @default(250)
  porkLoinPricePerKg  Float    @default(350)
  porkHipPricePerKg   Float    @default(350)
  lastPorkCleanupMonth String?
  lastSlipCleanupDate String?
  packingCutoffDate   String? // date (YYYY-MM-DD) Packing last closed out — new orders created while today matches this date get numbered under the next day instead
  updatedAt           DateTime @updatedAt
}

// A for-fun, employee-morale feature — exactly one virtual pet per admin,
// unrelated to real business data beyond reading that admin's own order
// count (see app/api/pets/route.ts). Growth stage and item-unlock state are
// never stored here — both are derived live from the admin's current order
// count via lib/petCatalog.ts, so they can never drift out of sync with
// reality; this row only persists what an admin actually chose (which
// species is currently active, what's equipped).
model Pet {
  id     String @id @default(uuid())
  // Unique (not part of a compound key) — exactly one pet row per admin,
  // ever. Switching species is an update to this same row, not a new one;
  // an admin can switch as often as they like, but only one is ever active.
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Key into lib/petCatalog.ts's SPECIES registry — a plain string (not a
  // Prisma enum) so a new species only ever needs a catalog entry, no
  // migration, same reasoning as RackAssignment.productType.
  species String @default("PIG")
  // DEV-only manual override of growth stage ("baby"|"adult"), null = use
  // the normal order-count-derived stage. Every other role's pet always
  // has this null and is unaffected — see app/api/pets/route.ts and
  // app/api/pets/stage/route.ts, a DEV-only "see anything" toggle.
  stageOverride String?
  createdAt     DateTime @default(now())
}

model OrderAuditLog {
  id          String   @id @default(uuid())
  orderId     String?
  action      String
  summary     String
  performedBy String?
  createdAt   DateTime @default(now())
  // Only set for actions a caller needs to sum later (currently just
  // PENDING_STOCK_CANCELLED — see DELETE /api/pending-stock/[id] and
  // /api/pending-stock/cancelled-count) — the baht amount that action
  // reversed. Null for every plain EDIT/DELETE entry, which only ever
  // needed the free-text summary already stored above.
  amount      Float?
}

// A customer already committed to buying (paid up front, or agreed to COD),
// but there was no pork on hand to give them at order time — tracked here
// as its own lightweight waitlist (not a status on Order) since it's a
// simpler, ad-hoc workflow: log who's owed what, then check it off once
// stock arrives and it's delivered. Not linked to a specific Order row — an
// admin logs this by hand when the shortage comes up, independent of
// however that order itself was entered.
model PendingStock {
  id           String   @id @default(uuid())
  customerName String
  // Same customer-info fields Order Entry collects (platform through
  // needsTaxInvoice) — captured here too so whoever delivers once stock
  // arrives already has everything needed, without re-asking the customer.
  platform         String?
  socialMediaName  String?
  customerAddress  String?
  customerPhone    String?
  customerZip      String?
  needsTaxInvoice  Boolean  @default(false)
  // Array of { productType, weightKg, pricePerKg, price } line items —
  // productType keys into lib/rackCode.ts's PRODUCT_TYPES registry, same
  // reasoning as RackAssignment.productType (a plain string, not an enum).
  // A JSON column rather than a related table like Order.items: unlike real
  // orders, these lines never need their own query/join, just display and a
  // sum, so a table+relation here would be pure ceremony.
  items        Json
  shippingMethod         String?
  additionalShippingCost Float?
  // Set (auto-derived from total weight, same calculateCodAmount formula
  // Order Entry uses) when the customer will pay on delivery instead of up
  // front — null/0 for the normal pre-paid case. Carries straight through
  // to the real Order's own codAmount once "ส่งไป packing" converts this
  // entry, same as every other field here.
  codAmount              Float?
  // price + shipping + VAT(7%) + codAmount, same computeActualReceivedAmount
  // formula Order Entry uses. Stored rather than only computed live,
  // mirroring Order.actualReceivedAmount, so a later Settings rate change
  // doesn't retroactively change what an already-logged entry says it
  // expected.
  actualReceivedAmount   Float?
  // Left empty for a COD entry, which has no slip until the courier
  // collects on delivery.
  transferSlip String?
  // Extra slips beyond transferSlip (the primary one) — for when a
  // customer pays short the first time and transfers the rest separately,
  // same reason Order.extraSlips exists. A plain string array (not a
  // related table like OrderSlip) since PendingStock has no other related
  // tables and these only ever need their URL, no per-slip metadata beyond
  // that. Carries straight through to the real Order's own extraSlips once
  // "ส่งไป packing" converts this entry (see send-to-packing/route.ts).
  extraSlipUrls String[] @default([])
  // Purely an admin's own best guess ("น่าจะส่งได้ประมาณ...") for their own
  // planning — optional, never required, and never read by any date/
  // scheduling logic (send-to-packing still always uses the real day it's
  // actually sent). "YYYY-MM-DD", not a DateTime — there's no time
  // component to an estimate like this.
  expectedShipDate String?
  note         String?
  createdBy    String?
  // Set together with orderId once "ส่งไป packing" converts the WHOLE entry
  // (every line at once, not per-item — see
  // app/api/pending-stock/[id]/send-to-packing) into one real Order. Kept as
  // a permanent record rather than deleted, so there's a history of what got
  // resolved and when.
  fulfilledAt  DateTime?
  // The real Order this whole entry became once every line had stock
  // assigned and got sent to packing together — null until then. Used by
  // DELETE to know whether to restore assigned-but-unconverted stock (see
  // app/api/pending-stock/[id]/route.ts): once set, that stock legitimately
  // belongs to a real order, so it's left alone.
  orderId      String?
  createdAt    DateTime  @default(now())
}
